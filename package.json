{
  "name": "herdr-map",
  "version": "0.1.0",
  "description": "Zoomable canvas of every herdr agent, with click-to-focus in your terminal",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "build": "vite build",
    "start": "node server/index.ts",
    "dev:server": "node --watch server/index.ts",
    "dev:web": "vite",
    "test": "node --test 'test/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
